{
  "name": "agentic-first-principles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run data && astro dev",
    "data": "node scripts/build-data.mjs && node scripts/check-outline.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check-outline.mjs --strict",
    "vendor": "node scripts/vendor.mjs",
    "library": "node scripts/build-library.mjs",
    "build": "npm run data && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "^8.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.2.10",
    "shiki": "^4.6.0",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
